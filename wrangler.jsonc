{
  "name": "catsmoke-lou-zone",
  "compatibility_date": "2026-11-20",
  // Only /api/* runs the Worker (anonymous game stats); everything else is the static game, served as before.
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "catsmoke.lou.zone", "custom_domain": true }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Anonymous game stats (Workers Analytics Engine, switched on for the account 11/26). The live site writes
  // to catsmoke_stats; PR previews write to their own dataset so they never touch the real numbers.
  "analytics_engine_datasets": [{ "binding": "STATS", "dataset": "catsmoke_stats" }],
  // `wrangler preview` (the PR preview builds) needs this block; Preview bindings come from here.
  "previews": {
    "analytics_engine_datasets": [{ "binding": "STATS", "dataset": "catsmoke_stats_preview" }]
  }
}
