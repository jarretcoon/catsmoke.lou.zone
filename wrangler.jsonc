{
  "name": "catsmoke-lou-zone",
  "compatibility_date": "2026-11-20",
  // Only /api/* runs the Worker (anonymous game stats); everything else is the static game, served as before.
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "catsmoke.lou.zone", "custom_domain": true }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Workers Analytics Engine: the dataset is created on the first write. See worker/index.ts for the fields.
  "analytics_engine_datasets": [{ "binding": "STATS", "dataset": "catsmoke_stats" }],
  // Required by `wrangler preview` (the PR preview builds). Previews don't inherit bindings: their stats go to a
  // separate dataset so PR previews never write into the real numbers. Assets and compat settings stay top-level.
  "previews": {
    "analytics_engine_datasets": [{ "binding": "STATS", "dataset": "catsmoke_stats_preview" }]
  }
}
